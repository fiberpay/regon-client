  "description": "PHP client for GUS legal entities registry",
  "license": "MIT",
  "autoload": {
    "psr-4": {
      "Fiberpay\\RegonClient\\": "src/"
    }
  },
  "authors": [
    {
      "name": "Jędrzej Jarocki",
      "email": "jedrzej.jarocki@inpay.pl"
    },
    {
      "name": "Maciej Rybak",
      "email": "maciej.rybak@inpay.pl"
    }
  ],
  "require": {
    "php": "^8.1",
    "ext-soap": "*",
    "ext-simplexml": "*",
    "ext-json": "*"
